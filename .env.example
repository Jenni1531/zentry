# --- BASE DE DATOS (PostgreSQL / NeonDB) ---
DB_URL=jdbc:postgresql://<neon-host>/neondb?user=<neon-user>&password=<neon-password>&sslmode=require&channelBinding=require
DB_USERNAME=<neon-user>
DB_PASSWORD=<neon-password>

# --- JWT CONFIGURATION ---
# Genera un string largo y seguro en hexadecimal (mínimo 256 bits) para producción
JWT_SECRET=tu_secreto_jwt_seguro_y_largo_aqui
JWT_EXPIRATION_MS=86400000

# --- CORS ---
# Orígenes desde los que el navegador puede llamar a la API, separados por coma.
# Si falta, cae al default de SecurityConfig (localhost:3000,localhost:5173), que
# NO incluye el dominio público de producción.
ALLOWED_ORIGINS=https://zentrycommunity.tail314909.ts.net:8443

# --- EMAIL (envío de código OTP de verificación por Gmail SMTP) ---
# Obligatorias: sin ellas el backend no arranca. MAIL_PASSWORD debe ser una
# "contraseña de aplicación" de Google (no la contraseña normal de la cuenta),
# generada en https://myaccount.google.com/apppasswords (requiere 2FA activado).
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_contraseña_de_aplicacion_de_16_caracteres
